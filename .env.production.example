# ArtFlow - Production Environment Variables
# Copy this file to .env.production and fill with real values

# Node.js
NODE_ENV=production
PORT=3333

# Database
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_DATABASE=artflow_prod

# JWT
JWT_SECRET=CHANGE_THIS_STRONG_SECRET
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://artflow.iel-company.com.br

# Upload
MAX_FILE_SIZE=10
UPLOAD_DIR=/app/uploads/

# Monitoring
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# Optional: Advanced
# SENTRY_DSN=
# LOG_LEVEL=info
